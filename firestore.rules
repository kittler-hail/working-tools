rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'adminrey@workingtools.com';
    }

    // Member Safety: siapa pun yang sudah login boleh baca & menambah id baru,
    // tapi cuma admin yang boleh mengubah/menghapus entri yang sudah ada. Field addedBy
    // (siapa yang menambahkan, dipakai di halaman Profil) tidak boleh atas nama orang
    // lain — kecuali admin, karena import backup mengembalikan addedBy aslinya.
    match /flags/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/flags/$(docId))
                    && (isAdmin() || !('addedBy' in request.resource.data) || request.resource.data.addedBy == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Cara Penggunaan per halaman: siapa pun yang sudah login boleh baca, cuma
    // admin boleh menulis.
    match /pageNotes/{page} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Permintaan pembuatan akun: siapa pun (termasuk yang belum login, karena
    // memang belum punya akun) boleh mengirim satu permintaan baru berstatus
    // "pending" tanpa field aneh-aneh. Cuma admin yang boleh membaca daftarnya
    // (supaya email/nama pemohon tidak bisa dibaca publik) dan mengubah status-nya
    // (approve/reject).
    match /accountRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'note', 'status', 'requestedAt', 'reviewedAt', 'reviewedBy'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reviewedAt == null
                    && request.resource.data.reviewedBy == null
                    && request.resource.data.name is string && request.resource.data.name.size() > 0
                    && request.resource.data.email is string && request.resource.data.email.size() > 0
                    && request.resource.data.requestedAt is number;
      allow read, update, delete: if isAdmin();
    }

    // Profil akun non-admin yang dibuat admin lewat persetujuan permintaan akun.
    // Cuma dibaca/ditulis lewat halaman Permintaan Akun (admin), belum dipakai
    // user biasa membaca datanya sendiri — tapi dibuka untuk siapa pun yang login
    // supaya siap dipakai kalau nanti dibutuhkan tanpa perlu ubah rules lagi.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Log aktivitas (login/logout, ubah Member Safety, permintaan akun) — ditonton admin
    // lewat lonceng notifikasi dan halaman Pantau Pengguna. Supaya log tidak bisa
    // dipalsukan: waktunya harus waktu server (createdAt == request.time), dan pelakunya
    // harus akun yang sedang login (actorEmail == email akunnya). Satu-satunya pengecualian
    // adalah "mengajukan permintaan akun", yang memang terjadi sebelum punya akun (tanpa
    // actorEmail). Aksi yang memang khusus admin (hapus id, setujui/tolak akun) hanya
    // boleh dicatat oleh admin. Cuma admin yang boleh membaca/menghapus daftarnya.
    match /activityLog/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'actorEmail', 'requesterEmail', 'requesterName', 'targetId', 'targetEmail', 'category', 'createdAt'])
                    && request.resource.data.type is string
                    && request.resource.data.createdAt == request.time
                    && (
                      (request.resource.data.type == 'account_request_submitted'
                        && !request.resource.data.keys().hasAny(['actorEmail']))
                      || (isSignedIn()
                        && request.resource.data.actorEmail == request.auth.token.email
                        && (request.resource.data.type in ['login', 'logout', 'flag_add', 'password_change']
                          || (isAdmin() && request.resource.data.type in ['flag_delete', 'account_request_approved', 'account_request_rejected'])))
                    );
      allow read, delete: if isAdmin();
    }

    // Status pengguna untuk halaman Pantau Pengguna: tiap akun cuma boleh menulis
    // dokumen miliknya sendiri (id = uid), dengan email akunnya sendiri dan waktu server.
    // Isinya murni metadata (status, terakhir aktif, menu, perangkat) — tanpa data kerja.
    // Cuma admin yang boleh membacanya.
    match /presence/{uid} {
      allow create, update: if isSignedIn()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['email', 'status', 'lastActiveAt', 'lastLoginAt', 'lastPage', 'device'])
                            && request.resource.data.email == request.auth.token.email
                            && request.resource.data.status in ['online', 'offline']
                            && request.resource.data.lastActiveAt == request.time
                            && (!('lastLoginAt' in request.resource.data) || request.resource.data.lastLoginAt is timestamp)
                            && request.resource.data.lastPage is string && request.resource.data.lastPage.size() <= 40
                            && request.resource.data.device is string && request.resource.data.device.size() <= 60;
      allow read, delete: if isAdmin();
    }
  }
}
